# Database: SQLite for local development; PostgreSQL for shared/production use.
DATABASE_URL=sqlite:///./tennis.db

# Cito supports live scores and match/history endpoints, but NOT bookmaker odds.
TENNIS_HISTORICAL_PROVIDER=none
TENNIS_LIVE_PROVIDER=cito
TENNIS_ODDS_PROVIDER=none

# Create a free key in the Cito dashboard; store it locally, never commit it.
TENNIS_DATA_API_BASE_URL=https://api.citoapi.com/api/v1/tennis
TENNIS_DATA_API_KEY=
TENNIS_DATA_API_KEY_HEADER=x-api-key
TENNIS_DATA_API_KEY_PREFIX=
TENNIS_DATA_TIMEOUT_SECONDS=15

# Independent bookmaker odds provider. The Odds API tennis coverage is limited
# to selected tournaments; current tennis markets are mainly match winner,
# with selected game spreads and totals. Never commit a real key.
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4/
THE_ODDS_API_REGIONS=eu
THE_ODDS_API_MARKETS=h2h,spreads,totals
