# Database: SQLite for local development; PostgreSQL for shared/production use.
DATABASE_URL=sqlite:///./tennis.db

# Provider selection is independent for history, live scores and odds.
TENNIS_HISTORICAL_PROVIDER=none
TENNIS_LIVE_PROVIDER=none
TENNIS_ODDS_PROVIDER=none

# Configure only after selecting a provider and reviewing its documentation/terms.
TENNIS_DATA_API_BASE_URL=
TENNIS_DATA_API_KEY=
TENNIS_DATA_API_KEY_HEADER=Authorization
TENNIS_DATA_API_KEY_PREFIX=Bearer 
TENNIS_DATA_TIMEOUT_SECONDS=15
